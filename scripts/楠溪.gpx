不過能首探楠溪大瀑布也是值得了，
水色漂亮🤩天氣良好…
只能用攝影器材來攝影紀錄人生，
不枉此生😍</gpxhb:postscript><gpxhb:loadweight>18.1</gpxhb:loadweight><gpxhb:loadweight>21.2</gpxhb:loadweight><gpxhb:fitnesslevel>3</gpxhb:fitnesslevel><gpxhb:activitytype>hiking</gpxhb:activitytype><gpxhb:trackimageurl>https://assets.hikingbook.net/users/60w3wu1it91y2jmwdxciziq/90t3ufkuetfkv90q5e99gkoyg/7778d599-e54c-4485-895a-6541f994587e.jpg</gpxhb:trackimageurl></extensions></metadata><wpt lat="24.424179584079152" lon="121.70933308384893"><ele>242</ele><time>2026-06-18T22:33:44Z</time><name>00 Start</name><cmt>2026-06-19T06:33:44+08:00</cmt><desc>00 Start</desc><src>Hikingbook</src><link href="https://hikingbook.net/hikes/90t3UFKueTFKV90q5E99GKOyg"><text>Hikingbook</text></link><extensions><gpxhb:weather>Clear</gpxhb:weather><gpxhb:speed>-1.000000</gpxhb:speed><gpxhb:course>-1.000000</gpxhb:course></extensions></wpt><wpt lat="24.423072840393374" lon="121.70340937636578"><ele>271</ele><time>2026-06-18T22:50:21Z</time><name>01 吊橋</name><cmt>2026-06-19T06:50:21+08:00</cmt><desc>01 吊橋</desc><src>Hikingbook</src><link href="https://hikingbook.net/hikes/90t3UFKueTFKV90q5E99GKOyg"><text>Hikingbook</text></link><extensions><gpxhb:weather>Clear</gpxhb:weather><gpxhb:speed>-1.000000</gpxhb:speed><gpxhb:course>-1.000000</gpxhb:course></extensions></wpt><wpt lat="24.42637302604912" lon="121.70173525763424"><ele>337</ele><time>2026-06-18T23:04:36Z</time><name>02 上切岔路口</name><cmt>2026-06-19T07:04:36+08:00</cmt><desc>02 上切岔路口</desc><src>Hikingbook</src><link href="https://hikingbook.net/hikes/90t3UFKueTFKV90q5E99GKOyg"><text>Hikingbook</text></link><extensions><gpxhb:weather>Clear</gpxhb:weather><gpxhb:speed>-1.000000</gpxhb:speed><gpxhb:course>-1.000000</gpxhb:course></extensions></wpt><wpt lat="24.405111805113883" lon="121.69835418462755"><ele>1329</ele><time>2026-06-19T07:38:20Z</time><name>03 下切</name><cmt>2026-06-19T15:38:20+08:00</cmt><desc>03 下切</desc><src>Hikingbook</src><link href="https://hikingbook.net/hikes/90t3UFKueTFKV90q5E99GKOyg"><text>Hikingbook</text></link><exte